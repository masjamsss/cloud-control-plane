# Terraform state / plans (never committed)
*.tfstate
*.tfstate.*
.terraform/
.terraform.tfstate.lock.info
*.tfplan

# Estate configuration — an operator's real values live here, never in git.
# The public safety gate (scripts/publish-gate.sh) reads this in private CI.
.estate-denylist.json

# Environment files (real values; *.env.example templates stay tracked)
.env
.env.local
**/.env
**/.env.local

# Node
node_modules/
dist/
build/
coverage/
*.log
.vite/

# Go
*.test
*.out

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# AI-assistant instruction files — local working notes for LLM sessions, never published.
CLAUDE.md
CLAUDE.local.md
AGENTS.md
.claude/

# Python bytecode
__pycache__/
*.pyc

# DOC-15 — generated on demand, deliberately not committed. Fully derivable from
# tools/schemadump/gen-azure-capability-reference.mjs plus the committed schemadump, so
# tracking it would create a regeneration obligation with nothing enforcing it. Ignored
# rather than merely absent, so running the generator does not leave a tempting diff.
docs/operations/terraform-capability-reference-azure/
